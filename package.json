    "dayjs": "^1.11.12",
    "nprogress": "^0.2.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/nprogress": "^0.2.3",
    "typescript": "^5.5.4",
    "webpack": "^5.53.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
